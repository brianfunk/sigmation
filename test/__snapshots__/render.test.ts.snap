exports[`render > renders TeX and MathML 1`] = `
"<math xmlns="http://www.w3.org/1998/Math/MathML" data-latex="\\sum_{i=1}^N 2^i" display="block">
  <munderover data-latex="\\sum_{i=1}^N">
    <mo data-latex="\\sum">&#x2211;</mo>
    <mrow data-mjx-texclass="ORD" data-latex="{i=1}">
      <mi data-latex="i">i</mi>
      <mo data-latex="=">=</mo>
      <mn data-latex="1">1</mn>
    </mrow>
    <mi data-latex="N">N</mi>
  </munderover>
  <msup data-latex="2^i">
    <mn data-latex="2">2</mn>
    <mi data-latex="i">i</mi>
  </msup>
</math>"
`;
