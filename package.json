{
  "name": "sigmation",
  "version": "1.0.6",
  "description": "Σigmation — render math (AsciiMath, TeX) to SVG, PNG, MathML, HTML and badges. Library, CLI and API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "sigmation": "./dist/cli.js"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx src/api/server.ts",
    "assets": "tsx scripts/assets.mts",
    "build": "npm run build:lib && npm run build:site",
    "prepublishOnly": "npm run lint && npm test && npm run build:lib",
    "build:lib": "tsup && tsc -p tsconfig.dts.json",
    "build:site": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianfunk/sigmation.git"
  },
  "homepage": "https://sigmation.dev",
  "bugs": {
    "url": "https://github.com/brianfunk/sigmation/issues"
  },
  "keywords": [
    "sigmation",
    "sigma",
    "summation",
    "math",
    "mathematics",
    "mathjax",
    "latex",
    "tex",
    "asciimath",
    "svg",
    "png",
    "mathml",
    "badge",
    "api"
  ],
  "author": "Brian Funk",
  "license": "MIT",
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "mathjax": "^4.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.3",
    "@netlify/functions": "^6.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "hono": "^4.13.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "uqr": "^0.1.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
